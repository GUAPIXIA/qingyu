{
  "name": "qingyu",
  "private": true,
  "version": "0.11.27",
  "type": "module",
  "description": "轻语 - 轻量级 AI 角色扮演客户端",
  "author": "QingYu",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "node electron-build.mjs && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "electron:build": "node electron-build.mjs && vite build && electron-builder --win --publish never",
    "electron:preview": "node electron-build.mjs && vite build && electron .",
    "lint": "eslint .",
    "check": "tsc -b --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "qrcode": "^1.5.4",
    "tiktoken": "^1.0.22",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "date-fns": "^3.6.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.0.0",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.0.7",
    "node-edge-tts": "^1.2.10",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.3.0",
    "react-virtuoso": "^4.18.11",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.15.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "wait-on": "^7.2.0",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.qingyu.app",
    "productName": "轻语",
    "directories": {
      "output": "release-v2"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/tiktoken/**/*",
      "!node_modules/tiktoken/encoders/**",
      "!node_modules/tiktoken/lite/**",
      "!node_modules/tiktoken/*.js",
      "!node_modules/tiktoken/*.json",
      "!node_modules/tiktoken/*.d.ts",
      "!node_modules/tiktoken/init.cjs",
      "!node_modules/tiktoken/load.cjs",
      "!node_modules/tiktoken/README.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "轻语"
    }
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
