NODE_ENV=production
PORT=3100
RELAY_BIND_PORT=3100
RELAY_PUBLIC_URL=https://relay.example.com
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=postgresql://qingyu_relay:replace-with-the-same-url-safe-random-password@postgres/qingyu_relay
REDIS_URL=redis://redis:6379/0
JWT_PRIVATE_KEY_PATH=/run/secrets/relay_jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/relay_jwt_public.pem
TOKEN_PEPPER=replace-with-at-least-32-random-bytes
PAIR_CODE_PEPPER=replace-with-different-at-least-32-random-bytes
S3_ENDPOINT=http://minio:9000
S3_BUCKET=qingyu-relay
S3_ACCESS_KEY=replace-with-random-access-key
S3_SECRET_KEY=replace-with-random-secret-key
MINIO_ROOT_USER=replace-with-the-same-random-access-key
MINIO_ROOT_PASSWORD=replace-with-the-same-random-secret-key
DEFAULT_SPACE_QUOTA_BYTES=524288000
DEFAULT_CACHE_RETENTION_DAYS=7
REGISTRATION_MODE=open
