# ============================================
# 轻语公告服务端环境变量配置
# 复制此文件为 .env 后修改实际值
# ============================================

# 服务端口
PORT=3000

# JWT 密钥（必填，至少 32 位随机字符串）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请替换为随机生成的密钥

# 管理员初始密码（必填，首次启动时创建管理员账号，至少 8 位）
ADMIN_PASSWORD=请替换为安全的密码

# CORS 允许的来源（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── 可选：数据与静态目录（不设置时用下方默认值） ──────────────

# 数据目录（默认 server/app/data）
# DB_DATA_DIR=

# SQLite 文件路径（默认 <DB_DATA_DIR>/tavern.db；测试可用 :memory: 隔离，不落盘）
# DB_PATH=

# 更新包静态目录（默认 server/app/data/updates，经 /update 路径对外提供）
# UPDATES_DIR=

# 反向代理信任跳数（默认 0 不信任；经 nginx／CDN 部署时必须设为实际跳数，
# 否则 Express 只能看到代理 IP，限流与日志里的来源地址会失真）
# TRUST_PROXY=1
