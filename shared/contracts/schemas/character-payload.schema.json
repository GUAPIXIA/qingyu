{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qingyu/sync/character-payload",
  "title": "CharacterPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "maxLength": 100000 },
    "personality": { "type": "string", "maxLength": 50000 },
    "scenario": { "type": "string", "maxLength": 50000 },
    "firstMessage": { "type": "string", "maxLength": 100000 },
    "exampleDialog": { "type": "string", "maxLength": 100000 },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 64 }
    },
    "creator": { "type": "string", "maxLength": 128 },
    "boundLorebookIds": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 128 }
    },
    "boundPresetId": { "type": ["string", "null"], "maxLength": 128 },
    "alternateGreetings": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 100000 }
    },
    "systemPrompt": { "type": "string", "maxLength": 100000 },
    "avatarBlobId": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "extensions": { "type": "object" }
  }
}
