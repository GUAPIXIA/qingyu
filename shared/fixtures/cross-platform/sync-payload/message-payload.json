{
  "algorithm": "electron/ipc/chat.ts#messageEntityPayload",
  "deliberatelyExcluded": [
    "id",
    "images",
    "isEditing",
    "translation",
    "charUsage",
    "generationError",
    "generationNotice",
    "contentRenderMode",
    "dialogueDirections",
    "dialogueDirectionsGeneratedAt"
  ],
  "cases": [
    {
      "label": "minimal-text",
      "keys": [
        "characterId",
        "content",
        "role",
        "sessionId",
        "timestamp"
      ],
      "payload": {
        "sessionId": "s-1",
        "role": "user",
        "content": "在吗",
        "timestamp": 1700000000000,
        "characterId": "char-full"
      }
    },
    {
      "label": "assistant-with-swipes",
      "keys": [
        "characterId",
        "content",
        "role",
        "sessionId",
        "swipeIndex",
        "swipes",
        "timestamp"
      ],
      "payload": {
        "sessionId": "s-1",
        "role": "assistant",
        "content": "正文",
        "timestamp": 1700000000000,
        "characterId": "char-full",
        "swipes": [
          "候选甲",
          "候选乙"
        ],
        "swipeIndex": 1
      }
    },
    {
      "label": "null-character-and-reply",
      "keys": [
        "characterId",
        "content",
        "replyToId",
        "role",
        "sessionId",
        "timestamp"
      ],
      "payload": {
        "sessionId": "s-1",
        "role": "user",
        "content": "在吗",
        "timestamp": 1700000000000,
        "characterId": null,
        "replyToId": "m-0"
      }
    },
    {
      "label": "omniscient-speaker-and-generation",
      "keys": [
        "characterId",
        "content",
        "generationKind",
        "narrativeMode",
        "role",
        "sessionId",
        "speakerKind",
        "timestamp"
      ],
      "payload": {
        "sessionId": "s-1",
        "role": "assistant",
        "content": "在吗",
        "timestamp": 1700000000000,
        "characterId": "char-full",
        "speakerKind": "narrator",
        "generationKind": "regenerate",
        "narrativeMode": "omniscient"
      }
    },
    {
      "label": "local-only-fields-are-not-sent",
      "keys": [
        "characterId",
        "content",
        "role",
        "sessionId",
        "timestamp"
      ],
      "payload": {
        "sessionId": "s-1",
        "role": "user",
        "content": "在吗",
        "timestamp": 1700000000000,
        "characterId": "char-full"
      }
    }
  ]
}
