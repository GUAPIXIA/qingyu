{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qingyu/spatial/command-v1",
  "title": "SpatialCommandBatchV1",
  "description": "空间命令批次 v1：UI、剧情与导入统一入口。携带 expectedRevision 做乐观并发控制。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "expectedRevision",
    "commands"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "coordinate": {
      "type": "number"
    },
    "positiveSize": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "regionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "boardId",
        "kind",
        "name",
        "description",
        "tags",
        "parentNodeId",
        "childBoardId",
        "createdAt",
        "updatedAt",
        "geometry"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "boardId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "region"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "parentNodeId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "childBoardId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            },
            "width": {
              "$ref": "#/$defs/positiveSize"
            },
            "height": {
              "$ref": "#/$defs/positiveSize"
            }
          }
        }
      }
    },
    "placeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "boardId",
        "kind",
        "name",
        "description",
        "tags",
        "parentNodeId",
        "childBoardId",
        "createdAt",
        "updatedAt",
        "geometry",
        "iconKey"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "boardId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "place"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "parentNodeId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "childBoardId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        "childLayout": {
          "enum": [
            "row",
            "column",
            "column-right"
          ]
        },
        "iconKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      }
    },
    "spatialNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/regionNode"
        },
        {
          "$ref": "#/$defs/placeNode"
        }
      ]
    },
    "distanceRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "boardId",
        "sourceNodeId",
        "targetNodeId",
        "name",
        "description",
        "measurement",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "distance"
        },
        "boardId": {
          "$ref": "#/$defs/id"
        },
        "sourceNodeId": {
          "$ref": "#/$defs/id"
        },
        "targetNodeId": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "displayText",
            "certainty"
          ],
          "properties": {
            "value": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "unit": {
              "enum": [
                "m",
                "km",
                "au",
                "ly",
                "custom"
              ]
            },
            "customUnit": {
              "$ref": "#/$defs/name"
            },
            "displayText": {
              "$ref": "#/$defs/name"
            },
            "certainty": {
              "enum": [
                "exact",
                "estimated",
                "unknown"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "unit": {
                    "const": "custom"
                  }
                },
                "required": [
                  "unit"
                ]
              },
              "then": {
                "required": [
                  "customUnit"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                },
                "required": [
                  "value"
                ]
              },
              "then": {
                "properties": {
                  "displayText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          ]
        },
        "travelNotes": {
          "$ref": "#/$defs/note"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "spatialNodePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "parentNodeId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "childBoardId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "iconKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            },
            "width": {
              "$ref": "#/$defs/positiveSize"
            },
            "height": {
              "$ref": "#/$defs/positiveSize"
            }
          }
        }
      }
    },
    "distanceRelationPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "sourceNodeId": {
          "$ref": "#/$defs/id"
        },
        "targetNodeId": {
          "$ref": "#/$defs/id"
        },
        "travelNotes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/note"
            }
          ]
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "value": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ]
            },
            "unit": {
              "enum": [
                "m",
                "km",
                "au",
                "ly",
                "custom"
              ]
            },
            "customUnit": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/name"
                }
              ]
            },
            "displayText": {
              "$ref": "#/$defs/name"
            },
            "certainty": {
              "enum": [
                "exact",
                "estimated",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "placementAnchorInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "board",
            "node"
          ]
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "node"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "nodeId"
        ]
      }
    },
    "semanticPositionInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision"
      ],
      "properties": {
        "relativeToNodeId": {
          "$ref": "#/$defs/id"
        },
        "relativeDirection": {
          "enum": [
            "north",
            "north-east",
            "east",
            "south-east",
            "south",
            "south-west",
            "west",
            "north-west",
            "center",
            "inside",
            "nearby"
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "inside-only",
            "unknown"
          ]
        },
        "note": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "actorPlacementInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardId",
        "anchor"
      ],
      "properties": {
        "boardId": {
          "$ref": "#/$defs/id"
        },
        "anchor": {
          "$ref": "#/$defs/placementAnchorInput"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/coordinate"
            },
            "y": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        "semanticPosition": {
          "$ref": "#/$defs/semanticPositionInput"
        }
      }
    },
    "placementGuard": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "boardId": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "updateCommandWorld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "patch"
      ],
      "properties": {
        "type": {
          "const": "update_world"
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "$ref": "#/$defs/name"
            },
            "description": {
              "$ref": "#/$defs/description"
            }
          }
        }
      }
    },
    "createCommandNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "create_node"
        },
        "payload": {
          "$ref": "#/$defs/spatialNode"
        }
      }
    },
    "updateCommandNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "nodeId",
        "patch"
      ],
      "properties": {
        "type": {
          "const": "update_node"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "patch": {
          "$ref": "#/$defs/spatialNodePatch"
        }
      }
    },
    "deleteCommandNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "nodeId",
        "strategy"
      ],
      "properties": {
        "type": {
          "const": "delete_node"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "strategy": {
          "enum": [
            "reject-if-not-empty",
            "cascade"
          ]
        }
      }
    },
    "createCommandActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "create_actor"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "externalRef",
            "displayName"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "persona",
                "character"
              ]
            },
            "externalRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "qingyu-persona",
                    "qingyu-character",
                    "standalone"
                  ]
                },
                "id": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "displayName": {
              "$ref": "#/$defs/name"
            },
            "description": {
              "$ref": "#/$defs/description"
            },
            "avatarAssetRef": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    },
    "updateCommandActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actorId",
        "patch"
      ],
      "properties": {
        "type": {
          "const": "update_actor"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "displayName": {
              "$ref": "#/$defs/name"
            },
            "description": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/description"
                }
              ]
            },
            "avatarAssetRef": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 512
                }
              ]
            },
            "kind": {
              "enum": [
                "persona",
                "character"
              ]
            },
            "externalRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "qingyu-persona",
                    "qingyu-character",
                    "standalone"
                  ]
                },
                "id": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "deleteCommandActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actorId"
      ],
      "properties": {
        "type": {
          "const": "delete_actor"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "createCommandDistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "type": {
          "const": "create_distance"
        },
        "payload": {
          "$ref": "#/$defs/distanceRelation"
        }
      }
    },
    "updateCommandDistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "relationId",
        "patch"
      ],
      "properties": {
        "type": {
          "const": "update_distance"
        },
        "relationId": {
          "$ref": "#/$defs/id"
        },
        "patch": {
          "$ref": "#/$defs/distanceRelationPatch"
        }
      }
    },
    "deleteCommandDistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "relationId"
      ],
      "properties": {
        "type": {
          "const": "delete_distance"
        },
        "relationId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "placeCommandActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actorId",
        "placement"
      ],
      "properties": {
        "type": {
          "const": "place_actor"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "placement": {
          "$ref": "#/$defs/actorPlacementInput"
        }
      }
    },
    "moveCommandActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actorId",
        "to"
      ],
      "properties": {
        "type": {
          "const": "move_actor"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/placementGuard"
        },
        "to": {
          "$ref": "#/$defs/actorPlacementInput"
        },
        "reason": {
          "$ref": "#/$defs/note"
        }
      }
    },
    "removeCommandActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "actorId"
      ],
      "properties": {
        "type": {
          "const": "remove_actor_from_board"
        },
        "actorId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "$ref": "#/$defs/updateCommandWorld"
        },
        {
          "$ref": "#/$defs/createCommandNode"
        },
        {
          "$ref": "#/$defs/updateCommandNode"
        },
        {
          "$ref": "#/$defs/deleteCommandNode"
        },
        {
          "$ref": "#/$defs/createCommandDistance"
        },
        {
          "$ref": "#/$defs/updateCommandDistance"
        },
        {
          "$ref": "#/$defs/deleteCommandDistance"
        },
        {
          "$ref": "#/$defs/createCommandActor"
        },
        {
          "$ref": "#/$defs/updateCommandActor"
        },
        {
          "$ref": "#/$defs/deleteCommandActor"
        },
        {
          "$ref": "#/$defs/placeCommandActor"
        },
        {
          "$ref": "#/$defs/moveCommandActor"
        },
        {
          "$ref": "#/$defs/removeCommandActor"
        }
      ]
    }
  }
}
